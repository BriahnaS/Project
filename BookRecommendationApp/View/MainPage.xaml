<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookRecommendationApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Secondary}">

    <Grid BackgroundColor="#2F3E46" RowDefinitions="*,*" Padding="20">
        <Label 
            FontSize="16"
            HorizontalOptions="Center"
            Text="Welcome to Build-A-Rec"
            TextColor="#B8B2A6"
            VerticalOptions="Center" />
        <Button
            Grid.Row="0"
            Text="Build-A-Rec"
            FontSize="24"
            CornerRadius="20"
            BackgroundColor="#52796F"
            TextColor="#B8B2A6" />
        <Button
            Grid.Row="1"
            Text="Find a Random Book"
            FontSize="24"
            CornerRadius="20"
            BackgroundColor="#52796F"
            TextColor="#B8B2A6" 
            Command="{Binding LoadRandomBookCommand}"/>
        <CollectionView
            x:Name="BookCarousel"
            ItemsSource="{Binding CarouselBooks}"
            ItemsLayout="HorizontalList"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never"
            HeightRequest="250"
            <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" CornerRadius="15">
                    <Label Text="{Binding Title}" FontSize="18" />
                    <Label Text="{Binding Author}" FontSize="14" />
                </Frame>
            </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
