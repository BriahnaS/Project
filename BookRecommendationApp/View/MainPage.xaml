<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookRecommendationApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F3E9">

    <Grid BackgroundColor="#2F3E46" RowDefinitions="Auto, Auto, Auto, *, Auto" Padding="20" RowSpacing="15">
        <Label 
            Grid.Row="0"
            FontSize="30"
            HorizontalOptions="Center"
            Text="Welcome to Build-A-Rec"
            TextColor="#B8B2A6"
            VerticalOptions="Center" />
        <Button
            Grid.Row="1"
            Text="Build-A-Rec"
            Clicked="OnBuildARecClicked"
            FontSize="24"
            CornerRadius="20"
            BackgroundColor="#52796F"
            TextColor="#B8B2A6" />
        <Button
            Grid.Row="2"
            Text="Find a Random Book"
            FontSize="24"
            CornerRadius="20"
            BackgroundColor="#52796F"
            TextColor="#B8B2A6" 
            Clicked="OnRandomBookClicked"/>

    </Grid>
</ContentPage>
