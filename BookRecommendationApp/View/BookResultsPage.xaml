<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BookRecommendationApp.View"
             xmlns:views="clr-namespace:BookRecommendationApp.View"
             xmlns:viewmodel="clr-namespace:BookRecommendationApp.ViewModel"
             x:Class="BookRecommendationApp.View.BookResultsPage"
             x:Name="BookResultsPageRoot"
             BackgroundColor="#F7F3E9">


    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" 
               Text="Books That Fit Your Mood" 
               TextColor="Black"
               FontSize="28"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
        
        <ScrollView Grid.Row="1">
            <CollectionView ItemsSource="{Binding Books}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Background="White"
                                Padding="5"
                                Margin="10"
                                StrokeShape="RoundRectangle 12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference BookResultsPageRoot}, Path=BindingContext.OpenBookDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Padding="10" Spacing="10">

                                <Image Source="{Binding CoverImageUrl}"
                                       HeightRequest="150"
                                       WidthRequest="100"
                                       Aspect="AspectFill" 
                                       Margin="0, 10"/>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="20"
                                           TextColor="Black" />

                                    <Label Text="{Binding AuthorList}"
                                           FontSize="16"
                                           TextColor="Gray" />

                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
        
        <Button Text="Start Over"
                BackgroundColor="#52796F"
                TextColor="White"
                CornerRadius="10"
                Padding="15,10"
                Margin="20"
                HorizontalOptions="End"
                Clicked="OnStartOverClicked"/>
    </Grid>
</ContentPage>