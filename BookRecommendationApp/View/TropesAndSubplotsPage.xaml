<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="BookRecommendationApp.View.TropesAndSubplotsPage"
             x:Name="TropesAndSubplotsPageRoot"
             BackgroundColor="#F7F3E9">
    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill">
            <VerticalStackLayout Padding="20" 
                                 Spacing="10"
                                 VerticalOptions="Start"
                                 HorizontalOptions="Center">
                <Label 
                Text="Tropes" 
                FontSize="24" 
                TextColor="Black"
                HorizontalOptions="Center"/>

                <CollectionView ItemsSource="{Binding Tropes}"
                                SelectionMode="None"
                                HorizontalOptions="Center">
                    
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" 
                                           ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:Border 
                                StrokeThickness="0"
                                Background="#354F52"
                                StrokeShape="RoundRectangle 20"
                                Padding="8,4"
                                Margin="4">

                                <controls:Border.Style>
                                    <Style TargetType="controls:Border">
                                        <Setter Property="Background" Value="#354F52" />
                                        <Setter Property="HeightRequest" Value="40" />
                                        <Setter Property="MinimumWidthRequest" Value="80" />

                                        <Style.Triggers>
                                            <DataTrigger TargetType="controls:Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#52796F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Border.Style>

                                <Grid>
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="#CAD2C5" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectTropeCommand, Source={x:Reference TropesAndSubplotsPageRoot}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </controls:Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label 
                    Text="Subplots" 
                    FontSize="24" 
                    TextColor="Black" 
                    HorizontalOptions="Center"
                    Margin="0,80,0,0"/>
                
                <CollectionView ItemsSource="{Binding Subplots}"
                                SelectionMode="None"
                                HorizontalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" 
                                           ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:Border StrokeThickness="0"
                                            Background="#354F52"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="8, 4"
                                            Margin="4">

                                <controls:Border.Style>
                                    <Style TargetType="controls:Border">
                                        <Setter Property="Background" Value="#354F52" />
                                        <Setter Property="HeightRequest" Value="40"/>
                                        <Setter Property="MinimumWidthRequest" Value="80" />



                                        <Style.Triggers>
                                            <DataTrigger TargetType="controls:Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#52796F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Border.Style>

                                <Grid>
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="#CAD2C5" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SelectSubplotCommand, Source={x:Reference TropesAndSubplotsPageRoot}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </controls:Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1">
            <Button
                Text="Find Your Books"
                CornerRadius="10"
                BackgroundColor="#52796F"
                TextColor="White"
                Padding="15,10"
                Margin="20"
                HorizontalOptions="End"
                Clicked="FindBooksClicked" />
        </Grid>

    </Grid>
</ContentPage>