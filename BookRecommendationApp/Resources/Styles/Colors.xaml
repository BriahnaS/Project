<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="InkSlate">#2F3E46</Color>
    <Color x:Key="DeepTeal">#354F52</Color>
    <Color x:Key="SoftSandstone">#DCC7A1</Color>
    <Color x:Key="CreamPage">#F7F3E9</Color>
    <Color x:Key="OffWhitePage">#F0EDE5</Color>
    <Color x:Key="WarmTaupe">#B89F7A</Color>
    <Color x:Key="DustyMocha">#8E7C6E</Color>
    <Color x:Key="MossyGreen">#52796F</Color>
    <Color x:Key="MutedClay">#B8B2A6</Color>
    <Color x:Key="CaramelLatte">#A67C52</Color>

    <!-- Rich earthy browns -->
    <Color x:Key="DeepChestnut">#7B4F3A</Color>
    <Color x:Key="EarthUmber">#6A4E3B</Color>
    <Color x:Key="DarkWalnut">#4B3A2F</Color>
    <Color x:Key="CoffeeBean">#3C2F2F</Color>


    <Color x:Key="White">White</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="Primary" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="Secondary" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="Tertiary" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="Black" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>